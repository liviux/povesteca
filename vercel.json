{
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/mark.webp", "headers": [{ "key": "cache-control", "value": "public, max-age=604800" }] },
    { "source": "/wordmark.webp", "headers": [{ "key": "cache-control", "value": "public, max-age=604800" }] },
    { "source": "/favicon.png", "headers": [{ "key": "cache-control", "value": "public, max-age=604800" }] },
    { "source": "/icon-192.png", "headers": [{ "key": "cache-control", "value": "public, max-age=604800" }] }
  ]
}
